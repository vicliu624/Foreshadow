cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED AMC_CLI OR NOT EXISTS "${AMC_CLI}")
  message(FATAL_ERROR "AMC_CLI must point to the packaged receiver utility")
endif()

function(check_receiver receiver)
  execute_process(COMMAND "${AMC_CLI}" devices --receiver "${receiver}"
    RESULT_VARIABLE result OUTPUT_VARIABLE response ERROR_VARIABLE diagnostic TIMEOUT 15)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "${receiver} device query failed (${result}): ${diagnostic}")
  endif()
  string(JSON backend GET "${response}" backend)
  string(JSON devices_type TYPE "${response}" devices)
  if(NOT devices_type STREQUAL "ARRAY")
    message(FATAL_ERROR "Unexpected ${receiver} device response: ${response}")
  endif()
  if(backend STREQUAL "unavailable")
    string(JSON reason ERROR_VARIABLE parse_error GET "${response}" reason_code)
    if(NOT parse_error STREQUAL "NOTFOUND" OR reason STREQUAL "")
      message(FATAL_ERROR "Unavailable receiver omitted its reason: ${response}")
    endif()
  endif()
endfunction()

execute_process(COMMAND "${AMC_CLI}" receiver-plugins RESULT_VARIABLE result OUTPUT_VARIABLE plugins TIMEOUT 15)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Packaged receiver discovery failed")
endif()
string(JSON count LENGTH "${plugins}")
if(count GREATER 0)
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON status GET "${plugins}" ${index} status)
    if(status STREQUAL "rejected")
      message(FATAL_ERROR "Packaged receiver rejected: ${plugins}")
    elseif(status STREQUAL "loaded")
      string(JSON id GET "${plugins}" ${index} id)
      check_receiver("${id}")
    endif()
  endforeach()
endif()
