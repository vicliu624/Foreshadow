cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/PcmMediaDeployment.cmake")
string(RANDOM LENGTH 10 ALPHABET abcdef0123456789 run)
set(root "${AMC_BINARY_DIR}/pcm-deployment-${run}")
set(bundle "${root}/Foreshadow.app")
file(MAKE_DIRECTORY "${bundle}/Contents/Frameworks" "${bundle}/Contents/PlugIns/multimedia" "${root}/sdk/lib")
file(WRITE "${bundle}/Contents/Info.plist" "fixture")
file(WRITE "${bundle}/Contents/Frameworks/libavcodec.61.dylib" "qt-codec")
file(WRITE "${bundle}/Contents/Frameworks/libavcodec.dylib" "qt-alias")
file(WRITE "${bundle}/Contents/Frameworks/libQt6Multimedia.dylib" "qt-pcm")
file(WRITE "${bundle}/Contents/PlugIns/multimedia/libffmpegmediaplugin.dylib" "qt-backend")
file(WRITE "${root}/sdk/lib/libavcodec.63.dylib" "native-codec")
file(WRITE "${root}/sdk/lib/libavcodec.dylib" "native-alias")
file(WRITE "${root}/outside.dylib" "outside")
foreach(pass RANGE 1 2)
  amc_finalize_pcm_bundle("${bundle}" "${root}/sdk")
  if(EXISTS "${bundle}/Contents/Frameworks/libavcodec.61.dylib" OR
     EXISTS "${bundle}/Contents/PlugIns/multimedia/libffmpegmediaplugin.dylib")
    message(FATAL_ERROR "Unused Qt codec backend survived PCM deployment")
  endif()
  foreach(pair IN ITEMS "libavcodec.63.dylib|native-codec" "libavcodec.dylib|native-alias" "libQt6Multimedia.dylib|qt-pcm")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 name)
    list(GET fields 1 expected)
    file(READ "${bundle}/Contents/Frameworks/${name}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "PCM deployment lost an owned runtime: ${name}")
    endif()
  endforeach()
  file(READ "${root}/outside.dylib" outside)
  if(NOT outside STREQUAL "outside")
    message(FATAL_ERROR "PCM deployment modified a path outside the bundle")
  endif()
endforeach()
