cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED AMC_SOURCE_DIR)
  message(FATAL_ERROR "Set AMC_SOURCE_DIR to the AMC source directory")
endif()
get_filename_component(AMC_SOURCE_DIR "${AMC_SOURCE_DIR}" ABSOLUTE)

function(module_of path result)
  file(RELATIVE_PATH relative "${AMC_SOURCE_DIR}" "${path}")
  string(REGEX REPLACE "^(src/|include/signalscope/)" "" relative "${relative}")
  if(relative MATCHES "^(backend/(iq|dsp|distribution|transport|media)|adapters/(receivers|modulation|distribution|television|media)|frontend/(cli|desktop)|plugins/desktop/(display|research|common)|plugins/receivers|plugins/external|desktop)/")
    set(module "${CMAKE_MATCH_1}")
  elseif(relative MATCHES "^(backend|frontend|plugins)/")
    set(module "${CMAKE_MATCH_1}")
  else()
    set(module "")
  endif()
  set(${result} "${module}" PARENT_SCOPE)
endfunction()

function(check_sources directory allow_qt allow_receiver_drivers)
  file(GLOB_RECURSE sources LIST_DIRECTORIES FALSE
    "${AMC_SOURCE_DIR}/${directory}/*.cpp" "${AMC_SOURCE_DIR}/${directory}/*.hpp"
    "${AMC_SOURCE_DIR}/${directory}/*.h")
  if(NOT sources)
    message(FATAL_ERROR "No sources in module directory ${directory}")
  endif()
  set(allowed_modules "${ARGN}")
  foreach(source IN LISTS sources)
    get_filename_component(parent "${source}" DIRECTORY)
    file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
    foreach(line IN LISTS includes)
      if(NOT line MATCHES "^[ \t]*#[ \t]*include[ \t]*[<\"]([^>\"]+)[>\"]")
        continue()
      endif()
      set(header "${CMAKE_MATCH_1}")
      string(REPLACE "\\" "/" header "${header}")
      if(NOT allow_qt AND header MATCHES "^(Q[A-Z]|Qt|qt6/)")
        message(FATAL_ERROR "${source} includes Qt header ${header}")
      endif()
      if(NOT allow_receiver_drivers AND header MATCHES "^(SoapySDR/|rtl-sdr[^/]*\\.h$)")
        message(FATAL_ERROR "${source} includes receiver driver header ${header}")
      endif()
      foreach(include_root IN ITEMS "${parent}" "${AMC_SOURCE_DIR}/include" "${AMC_SOURCE_DIR}/src" "${AMC_SOURCE_DIR}")
        get_filename_component(target "${header}" ABSOLUTE BASE_DIR "${include_root}")
        if(EXISTS "${target}")
          module_of("${target}" dependency)
          if(dependency AND NOT dependency IN_LIST allowed_modules)
            message(FATAL_ERROR "${source} includes ${header} from disallowed module ${dependency}")
          endif()
          break()
        endif()
      endforeach()
    endforeach()
  endforeach()
endfunction()

foreach(prefix IN ITEMS src include/signalscope)
  check_sources("${prefix}/backend/iq" FALSE FALSE backend/iq)
  check_sources("${prefix}/backend/dsp" FALSE FALSE backend/dsp backend/iq)
  check_sources("${prefix}/adapters/receivers" FALSE FALSE adapters/receivers backend/iq backend/distribution)
  check_sources("${prefix}/adapters/modulation" FALSE FALSE adapters/modulation backend/iq backend/dsp)
  check_sources("${prefix}/backend/distribution" FALSE FALSE backend/distribution backend/iq)
  check_sources("${prefix}/backend/transport" FALSE FALSE backend/transport backend/iq)
  check_sources("${prefix}/backend/media" FALSE FALSE backend/media backend/iq)
  check_sources("${prefix}/adapters/television" TRUE FALSE adapters/television backend/iq backend/transport)
  check_sources("${prefix}/backend" FALSE FALSE backend backend/iq backend/dsp backend/distribution backend/transport backend/media adapters/receivers adapters/modulation)
endforeach()
check_sources(src/frontend/cli FALSE FALSE frontend/cli backend backend/iq backend/dsp backend/distribution adapters/receivers adapters/modulation)
check_sources(include/signalscope/desktop TRUE FALSE desktop backend/iq)
check_sources(src/frontend/desktop TRUE FALSE frontend/desktop backend backend/iq backend/dsp backend/distribution adapters/receivers adapters/modulation adapters/distribution desktop
              plugins/desktop/display plugins/desktop/research plugins/desktop/common)
check_sources(plugins/desktop/display TRUE FALSE plugins/desktop/display backend/dsp backend/iq desktop)
check_sources(plugins/desktop/research TRUE FALSE plugins/desktop/research plugins/desktop/common backend/dsp backend/iq backend/distribution backend/media backend/transport adapters/television adapters/modulation desktop)
check_sources(src/adapters/media FALSE FALSE adapters/media backend/media backend/transport backend/iq)
check_sources(plugins/desktop/common TRUE FALSE plugins/desktop/common backend/iq desktop)
check_sources(plugins/external/power_report FALSE FALSE backend/iq)
check_sources(plugins/receivers FALSE TRUE plugins/receivers adapters/receivers backend/iq)
check_sources(src/adapters/distribution TRUE FALSE adapters/distribution backend/distribution backend/iq)
check_sources(include/signalscope/adapters/distribution TRUE FALSE adapters/distribution backend/distribution backend/iq)
check_sources(tools/distribution TRUE FALSE backend/distribution backend/iq frontend/desktop)
