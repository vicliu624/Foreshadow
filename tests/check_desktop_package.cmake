function(run_check test)
  cmake_parse_arguments(CHECK "" "SKIP_RETURN_CODE" "" ${ARGN})
  set(test_executable "${AMC_TEST_BIN}/${test}${exe}")
  foreach(path IN ITEMS "${test_executable}" ${CHECK_UNPARSED_ARGUMENTS})
    if(path MATCHES "^--")
      continue()
    endif()
    if(NOT EXISTS "${path}")
      message(FATAL_ERROR "Required file for ${test} is missing: ${path}")
    endif()
  endforeach()
  message(STATUS "Checking the extracted package with ${test}")
  execute_process(COMMAND "${test_executable}" ${CHECK_UNPARSED_ARGUMENTS}
    RESULT_VARIABLE result TIMEOUT 180)
  if(DEFINED CHECK_SKIP_RETURN_CODE AND result STREQUAL "${CHECK_SKIP_RETURN_CODE}")
    message(STATUS "${test}: declared qualification skipped against the extracted package (${result}); raw observations retained")
  elseif(NOT result STREQUAL "0")
    message(FATAL_ERROR "${test} failed against the extracted package (${result})")
  endif()
endfunction()

