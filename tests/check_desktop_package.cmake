foreach(library IN ITEMS avcodec avformat avutil swresample swscale)
  if(CMAKE_HOST_WIN32)
    file(GLOB ffmpeg_libraries "${bin}/${library}-*.dll")
  elseif(CMAKE_HOST_APPLE)
    file(GLOB ffmpeg_libraries "${AMC_STAGE}/Foreshadow.app/Contents/Frameworks/lib${library}*.dylib")
  else()
    file(GLOB ffmpeg_libraries "${AMC_STAGE}/lib/lib${library}.so*")
  endif()
  set(real_libraries "")
  foreach(path IN LISTS ffmpeg_libraries)
    if(CMAKE_HOST_WIN32)
      # Windows packages contain real DLL entries. CMake 4.1.2 REAL_PATH
      # aborts on non-BMP paths even for an existing regular file; count the
      # actual directory entries without resolving ELF-style library aliases.
      set(real "${path}")
    else()
      file(REAL_PATH "${path}" real)
    endif()
    list(APPEND real_libraries "${real}")
  endforeach()
  list(REMOVE_DUPLICATES real_libraries)
  list(LENGTH real_libraries ffmpeg_abi_count)
  if(NOT ffmpeg_abi_count EQUAL 1)
    message(FATAL_ERROR "The PCM desktop package contains multiple/missing ${library} ABIs")
  endif()
endforeach()
