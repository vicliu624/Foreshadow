# Television uses a pinned shared FFmpeg build, including AVS+ Broadcasting.
# A system library that merely lists `cavs` is not an equivalent dependency.
include(ExternalProject)
include(ProcessorCount)
set(amc_ffmpeg_revision cd4e96eb314630788b7ff2f9820c395788c023e2)
set(amc_ffmpeg_download "${FETCHCONTENT_BASE_DIR}/amc-media-download")
FetchContent_Declare(ffmpeg_native
  URL "https://codeload.github.com/FFmpeg/FFmpeg/tar.gz/${amc_ffmpeg_revision}"
  URL_HASH SHA256=e3976ef0636e9c12d68c193abc4898ab50f05be3a4996026abc60c18be7447d4
  DOWNLOAD_DIR "${amc_ffmpeg_download}" DOWNLOAD_NAME ffmpeg-source.tar.gz)
FetchContent_MakeAvailable(ffmpeg_native)
set(SIGNALSCOPE_FFMPEG_ROOT "" CACHE PATH "Explicit development override for the pinned shared FFmpeg SDK")
ProcessorCount(media_jobs)
if(NOT media_jobs OR media_jobs GREATER 8)
  set(media_jobs 8)
endif()
set(SIGNALSCOPE_MEDIA_BUILD_JOBS "${media_jobs}" CACHE STRING "Parallel jobs for the native media dependency")
if(NOT SIGNALSCOPE_MEDIA_BUILD_JOBS MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "SIGNALSCOPE_MEDIA_BUILD_JOBS must be a positive integer")
endif()
if(SIGNALSCOPE_FFMPEG_ROOT)
  set(amc_ffmpeg_prefix "${SIGNALSCOPE_FFMPEG_ROOT}")
else()
  set(amc_ffmpeg_prefix "${FETCHCONTENT_BASE_DIR}/amc-media-sdk")
endif()
set(amc_ffmpeg_build "${FETCHCONTENT_BASE_DIR}/amc-media-build")
set(amc_ffmpeg_script "${PROJECT_SOURCE_DIR}/cmake/BuildFfmpeg.sh")
file(MAKE_DIRECTORY "${amc_ffmpeg_prefix}/include")
set(amc_ffmpeg_byproducts "")
foreach(library IN ITEMS avformat avcodec swresample swscale avutil)
  if(library STREQUAL avutil)
    set(version_header "${ffmpeg_native_SOURCE_DIR}/lib${library}/version.h")
  else()
    set(version_header "${ffmpeg_native_SOURCE_DIR}/lib${library}/version_major.h")
  endif()
  file(STRINGS "${version_header}" major_line REGEX "^#define +LIB[A-Z]+_VERSION_MAJOR +[0-9]+")
  string(REGEX REPLACE ".* +([0-9]+)$" "\\1" major "${major_line}")
  if(WIN32)
    # The pinned FFmpeg MSVC install places its import libraries beside DLLs
    # (SLIB_INSTALL_EXTRA_SHLIB), rather than in the archive-library directory.
    set(link_library "${amc_ffmpeg_prefix}/bin/${library}.lib")
    set(runtime_library "${amc_ffmpeg_prefix}/bin/${library}-${major}.dll")
  elseif(APPLE)
    set(link_library "${amc_ffmpeg_prefix}/lib/lib${library}.dylib")
    set(runtime_library "${amc_ffmpeg_prefix}/lib/lib${library}.${major}.dylib")
  else()
    set(link_library "${amc_ffmpeg_prefix}/lib/lib${library}.so")
    set(runtime_library "${amc_ffmpeg_prefix}/lib/lib${library}.so.${major}")
  endif()
  add_library(amc_ffmpeg_${library} SHARED IMPORTED GLOBAL)
  set_target_properties(amc_ffmpeg_${library} PROPERTIES
    IMPORTED_LOCATION "${runtime_library}" INTERFACE_INCLUDE_DIRECTORIES "${amc_ffmpeg_prefix}/include")
  if(WIN32)
    set_target_properties(amc_ffmpeg_${library} PROPERTIES IMPORTED_IMPLIB "${link_library}")
  elseif(APPLE)
    # These files are produced after generation, so CMake cannot inspect their
    # install names. Declare @rpath explicitly to generate build-tree LC_RPATHs.
    set_target_properties(amc_ffmpeg_${library} PROPERTIES IMPORTED_LOCATION "${link_library}"
      IMPORTED_SONAME "@rpath/lib${library}.${major}.dylib")
  else()
    set_target_properties(amc_ffmpeg_${library} PROPERTIES IMPORTED_LOCATION "${link_library}")
  endif()
  list(APPEND amc_ffmpeg_byproducts "${link_library}" "${runtime_library}")
endforeach()
if(NOT SIGNALSCOPE_FFMPEG_ROOT)
  find_program(SIGNALSCOPE_MEDIA_BASH NAMES bash HINTS C:/msys64/usr/bin C:/tools/msys64/usr/bin REQUIRED)
  if(MSVC)
    string(REGEX REPLACE "/VC/Tools/MSVC/.*$" "" amc_vs_root "${CMAKE_C_COMPILER}")
    set(amc_vcvars "${amc_vs_root}/VC/Auxiliary/Build/vcvars64.bat")
    if(NOT EXISTS "${amc_vcvars}")
      message(FATAL_ERROR "The native media build requires the MSVC x64 compiler and vcvars64.bat")
    endif()
    configure_file("${PROJECT_SOURCE_DIR}/cmake/BuildFfmpegWindows.cmd.in"
      "${PROJECT_BINARY_DIR}/BuildFfmpegWindows.cmd" @ONLY NEWLINE_STYLE CRLF)
    set(media_command "${PROJECT_BINARY_DIR}/BuildFfmpegWindows.cmd")
  else()
    find_program(amc_media_make NAMES gmake make REQUIRED)
    find_program(amc_media_nasm NAMES nasm)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|i.86)$" AND NOT amc_media_nasm)
      message(FATAL_ERROR "The optimized native media decoder requires NASM on x86; install nasm")
    endif()
    set(media_options "--cc=${CMAKE_C_COMPILER}" "--cxx=${CMAKE_CXX_COMPILER}" "--ar=${CMAKE_AR}" "--ranlib=${CMAKE_RANLIB}")
    if(APPLE)
      list(APPEND media_options "--install-name-dir=@rpath")
      if(CMAKE_OSX_DEPLOYMENT_TARGET)
        list(APPEND media_options "--extra-cflags=-mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}"
          "--extra-ldflags=-mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
      endif()
    elseif(CMAKE_CROSSCOMPILING)
      list(APPEND media_options --enable-cross-compile --target-os=linux "--arch=${CMAKE_SYSTEM_PROCESSOR}")
      if(CMAKE_SYSROOT)
        list(APPEND media_options "--sysroot=${CMAKE_SYSROOT}")
      endif()
    endif()
    set(media_command "${CMAKE_COMMAND}" -E env "MAKE=${amc_media_make}"
      "${SIGNALSCOPE_MEDIA_BASH}" "${amc_ffmpeg_script}" "${ffmpeg_native_SOURCE_DIR}"
      "${amc_ffmpeg_build}" "${amc_ffmpeg_prefix}" "${SIGNALSCOPE_MEDIA_BUILD_JOBS}" ${media_options})
  endif()
  ExternalProject_Add(amc_ffmpeg_sdk SOURCE_DIR "${ffmpeg_native_SOURCE_DIR}" BINARY_DIR "${amc_ffmpeg_build}"
    DOWNLOAD_COMMAND "" UPDATE_COMMAND "" CONFIGURE_COMMAND ""
    BUILD_COMMAND ${media_command} INSTALL_COMMAND "" BUILD_BYPRODUCTS ${amc_ffmpeg_byproducts})
  ExternalProject_Add_StepDependencies(amc_ffmpeg_sdk build "${amc_ffmpeg_script}")
  foreach(library IN ITEMS avformat avcodec swresample swscale avutil)
    add_dependencies(amc_ffmpeg_${library} amc_ffmpeg_sdk)
  endforeach()
endif()
add_subdirectory("${PROJECT_SOURCE_DIR}/src/adapters/media" "${PROJECT_BINARY_DIR}/src/adapters/media")
# Shared libraries remain replaceable. Include their complete source and build
# recipe alongside the LGPL terms, without an expiring external source offer.
set(amc_ffmpeg_source_archive "${amc_ffmpeg_download}/ffmpeg-source.tar.gz")
if(NOT EXISTS "${amc_ffmpeg_source_archive}")
  set(amc_ffmpeg_source_archive "${PROJECT_BINARY_DIR}/media-source-override.tar.gz")
  if(NOT EXISTS "${amc_ffmpeg_source_archive}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${amc_ffmpeg_source_archive}" .
      WORKING_DIRECTORY "${ffmpeg_native_SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
  endif()
endif()
install(FILES "${ffmpeg_native_SOURCE_DIR}/COPYING.LGPLv2.1" "${ffmpeg_native_SOURCE_DIR}/LICENSE.md"
  "${amc_ffmpeg_source_archive}" "${amc_ffmpeg_script}" "${PROJECT_SOURCE_DIR}/third_party/README.md"
  DESTINATION share/licenses/ams/television/ffmpeg COMPONENT SignalScope)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/third_party/dra/" DESTINATION share/licenses/ams/television/dra COMPONENT SignalScope)
install(FILES "${PROJECT_SOURCE_DIR}/third_party/README.zh-CN.md" DESTINATION share/licenses/ams/television/ffmpeg COMPONENT SignalScope)
if(APPLE)
  install(DIRECTORY "${amc_ffmpeg_prefix}/lib/" DESTINATION Foreshadow.app/Contents/Frameworks COMPONENT SignalScope FILES_MATCHING PATTERN "*.dylib")
  install(FILES "${ffmpeg_native_SOURCE_DIR}/COPYING.LGPLv2.1" "${ffmpeg_native_SOURCE_DIR}/LICENSE.md"
    "${amc_ffmpeg_source_archive}" "${amc_ffmpeg_script}" "${PROJECT_SOURCE_DIR}/third_party/README.md"
    DESTINATION Foreshadow.app/Contents/Resources/licenses/television/ffmpeg COMPONENT SignalScope)
  install(DIRECTORY "${PROJECT_SOURCE_DIR}/third_party/dra/" DESTINATION Foreshadow.app/Contents/Resources/licenses/television/dra COMPONENT SignalScope)
  install(FILES "${PROJECT_SOURCE_DIR}/third_party/README.zh-CN.md" DESTINATION Foreshadow.app/Contents/Resources/licenses/television/ffmpeg COMPONENT SignalScope)
elseif(WIN32)
  install(DIRECTORY "${amc_ffmpeg_prefix}/bin/" DESTINATION bin COMPONENT SignalScope FILES_MATCHING PATTERN "*.dll")
else()
  install(DIRECTORY "${amc_ffmpeg_prefix}/lib/" DESTINATION lib COMPONENT SignalScope FILES_MATCHING PATTERN "*.so*")
endif()
