# Optional native toolchain runtimes are an explicit build/distribution input.
# System Apple libc++ needs no extra files. Custom toolchains declare their
# complete closure and notices; the bundle audit rejects missing dependencies.
set(AMC_MACOS_EXTRA_RUNTIME_LIBRARIES "" CACHE STRING "Extra macOS toolchain dylibs to distribute")
set(AMC_MACOS_EXTRA_RUNTIME_LICENSE_FILES "" CACHE STRING "Notices for extra macOS toolchain runtimes")

function(amc_install_mac_runtime destination notices component)
  if(NOT APPLE)
    return()
  endif()
  if(AMC_MACOS_EXTRA_RUNTIME_LIBRARIES AND NOT AMC_MACOS_EXTRA_RUNTIME_LICENSE_FILES)
    message(FATAL_ERROR "Extra macOS runtimes require their distribution notices")
  endif()
  set(names "")
  foreach(library IN LISTS AMC_MACOS_EXTRA_RUNTIME_LIBRARIES)
    if(NOT EXISTS "${library}")
      message(FATAL_ERROR "Missing macOS runtime: ${library}")
    endif()
    get_filename_component(name "${library}" NAME)
    if(name IN_LIST names OR NOT name MATCHES "^[A-Za-z0-9_+.-]+\\.dylib$")
      message(FATAL_ERROR "Invalid or duplicate macOS runtime load name: ${name}")
    endif()
    list(APPEND names "${name}")
    get_filename_component(real "${library}" REALPATH)
    # Dereference development symlinks while keeping the declared load name.
    install(FILES "${real}" DESTINATION "${destination}" RENAME "${name}" COMPONENT "${component}")
  endforeach()
  foreach(notice IN LISTS AMC_MACOS_EXTRA_RUNTIME_LICENSE_FILES)
    if(NOT EXISTS "${notice}")
      message(FATAL_ERROR "Missing macOS runtime notice: ${notice}")
    endif()
    install(FILES "${notice}" DESTINATION "${notices}" COMPONENT "${component}")
  endforeach()
endfunction()

function(amc_mac_runtime_arguments output)
  set(arguments "")
  foreach(library IN LISTS AMC_MACOS_EXTRA_RUNTIME_LIBRARIES)
    get_filename_component(name "${library}" NAME)
    string(APPEND arguments " \"${name}\"")
  endforeach()
  set(${output} "${arguments}" PARENT_SCOPE)
endfunction()
