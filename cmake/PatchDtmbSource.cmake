# Apply narrowly reviewed changes to the pinned native dependency in the build
# tree. The fetched source remains intact; a changed upstream context is fatal.
function(amc_dtmb_patch_source source output manifest)
  file(READ "${source}" content)
  file(READ "${manifest}" specification)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}" "${manifest}")
  string(JSON count LENGTH "${specification}" replacements)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON before GET "${specification}" replacements ${index} before)
    string(JSON after GET "${specification}" replacements ${index} after)
    string(FIND "${content}" "${before}" position)
    if(position LESS 0)
      message(FATAL_ERROR "Pinned DTMB patch context missing: ${manifest}, change ${index}")
    endif()
    string(LENGTH "${before}" length)
    math(EXPR end "${position} + ${length}")
    string(SUBSTRING "${content}" ${end} -1 remainder)
    string(FIND "${remainder}" "${before}" duplicate)
    if(NOT duplicate LESS 0)
      message(FATAL_ERROR "Pinned DTMB patch context is ambiguous: ${manifest}, change ${index}")
    endif()
    string(REPLACE "${before}" "${after}" content "${content}")
  endforeach()
  get_filename_component(parent "${output}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  # configure_file preserves timestamps on identical content across reconfigure.
  set(stage "${output}.configure")
  file(WRITE "${stage}" "${content}")
  configure_file("${stage}" "${output}" COPYONLY)
endfunction()
