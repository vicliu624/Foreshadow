# Finalize a Qt 6.8+ bundle whose consumers use QAudioSink, not QMediaPlayer.
# macdeployqt may collect codec backends despite there being no codec consumer.
# Keep the native television SDK as the single FFmpeg runtime owner.
function(amc_finalize_pcm_bundle bundle ffmpeg_sdk)
  if(NOT EXISTS "${bundle}/Contents/Info.plist")
    message(FATAL_ERROR "PCM deployment requires an installed application bundle")
  endif()
  file(REAL_PATH "${bundle}" bundle_root)
  set(frameworks "${bundle}/Contents/Frameworks")
  set(media_plugins "${bundle}/Contents/PlugIns/multimedia")
  foreach(directory IN ITEMS "${frameworks}" "${media_plugins}")
    if(EXISTS "${directory}")
      file(REAL_PATH "${directory}" resolved)
      cmake_path(IS_PREFIX bundle_root "${resolved}" NORMALIZE inside_bundle)
      if(NOT inside_bundle)
        message(FATAL_ERROR "PCM deployment path escapes the installed bundle: ${directory}")
      endif()
    endif()
  endforeach()
  file(GLOB codec_plugins "${media_plugins}/*.dylib")
  foreach(plugin IN LISTS codec_plugins)
    file(REMOVE "${plugin}")
  endforeach()
  file(GLOB codec_runtimes "${frameworks}/lib*.dylib")
  foreach(runtime IN LISTS codec_runtimes)
    get_filename_component(name "${runtime}" NAME)
    if(name MATCHES "^lib(avcodec|avformat|avutil|avdevice|avfilter|swscale|swresample|postproc)(\\.[0-9]+)*\\.dylib$")
      file(REMOVE "${runtime}")
    endif()
  endforeach()
  if(NOT "${ffmpeg_sdk}" STREQUAL "")
    if(NOT IS_DIRECTORY "${ffmpeg_sdk}/lib")
      message(FATAL_ERROR "The owning native FFmpeg SDK is missing")
    endif()
    # Reinstall even unversioned symlinks: Qt deployment may have overwritten
    # them with an unrelated ABI. The subsequent relocation audits all links.
    file(INSTALL DESTINATION "${frameworks}" TYPE DIRECTORY FILES "${ffmpeg_sdk}/lib/"
      FILES_MATCHING PATTERN "*.dylib")
  endif()
endfunction()
