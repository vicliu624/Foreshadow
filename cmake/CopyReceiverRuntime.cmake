cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${AMC_RECEIVER_DIR}")
set(files "[]")
set(index 0)
foreach(runtime IN LISTS AMC_RECEIVER_RUNTIME_FILES)
  get_filename_component(name "${runtime}" NAME)
  file(COPY "${runtime}" DESTINATION "${AMC_RECEIVER_DIR}")
  string(JSON files SET "${files}" ${index} "\"${name}\"")
  math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${AMC_RECEIVER_DIR}/${AMC_RECEIVER_NAME}.runtime.json" "{\"schema\":1,\"files\":${files}}\n")
