function(amc_check_module_links target allow_qt allow_driver)
  set(allowed "${ARGN}")
  foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(links "${target}" "${property}")
    if(NOT links)
      continue()
    endif()
    foreach(link IN LISTS links)
      set(item "${link}")
      if(item MATCHES "^\\$<LINK_ONLY:(.*)>$")
        set(item "${CMAKE_MATCH_1}")
      endif()
      if(IS_ABSOLUTE "${item}")
        get_filename_component(item "${item}" NAME)
      endif()
      string(TOLOWER "${item}" lower)
      if(NOT allow_qt AND lower MATCHES "qt[56]::|qt[56][a-z]+[. ]")
        message(FATAL_ERROR "${target} must not link Qt: ${link}")
      endif()
      if(NOT allow_driver AND lower MATCHES "soapysdr|signalscope_soapy_driver|rtl-?sdr")
        message(FATAL_ERROR "${target} must not link receiver drivers: ${link}")
      endif()
      # Link items can be wrapped in CMake generator expressions.
      string(REGEX MATCHALL "signalscope[-_a-zA-Z0-9]*|amc-power-report" modules "${item}")
      foreach(module IN LISTS modules)
        if(NOT module IN_LIST allowed)
          message(FATAL_ERROR "${target} must not link module ${module} (from ${link})")
        endif()
      endforeach()
    endforeach()
  endforeach()
endfunction()

function(amc_check_project_module_links)
amc_check_module_links(signalscope_iq FALSE FALSE)
amc_check_module_links(signalscope_transport FALSE FALSE signalscope_iq)
amc_check_module_links(signalscope_media_protocol FALSE FALSE signalscope_iq)
