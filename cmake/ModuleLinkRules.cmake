  amc_check_module_links(signalscope_media_output FALSE FALSE signalscope_media_protocol)
  amc_check_module_links(signalscope-media FALSE FALSE signalscope_media_codecs signalscope_transport signalscope_media_output)
endif()
if(TARGET signalscope_dtmb_receiver)
  amc_check_module_links(signalscope_dtmb_receiver TRUE FALSE signalscope_iq signalscope_transport)
endif()
amc_check_module_links(signalscope_distribution FALSE FALSE signalscope_iq)
amc_check_module_links(signalscope_receivers FALSE FALSE signalscope_iq signalscope_distribution)
amc_check_module_links(signalscope_receiver_sdk FALSE FALSE signalscope_iq)
amc_check_module_links(amc-receiver-rtlsdr FALSE TRUE signalscope_receiver_sdk)
amc_check_module_links(amc-receiver-sdrplay FALSE TRUE signalscope_receiver_sdk signalscope_soapy_driver)
if(TARGET signalscope_soapy_driver)
  amc_check_module_links(signalscope_soapy_driver FALSE TRUE)
endif()
amc_check_module_links(signalscope_modulation FALSE FALSE signalscope_iq signalscope_dsp)
amc_check_module_links(signalscope_dsp FALSE FALSE signalscope_iq)
amc_check_module_links(signalscope_core FALSE FALSE signalscope_receivers signalscope_modulation signalscope_dsp)
amc_check_module_links(signalscope FALSE FALSE signalscope_core signalscope_distribution)
amc_check_module_links(amc-power-report FALSE FALSE signalscope_iq)
if(TARGET signalscope-gui)
  amc_check_module_links(signalscope_desktop_parameters TRUE FALSE signalscope_iq)
  amc_check_module_links(signalscope_desktop_display TRUE FALSE signalscope_dsp)
  amc_check_module_links(signalscope_desktop_research TRUE FALSE signalscope_iq signalscope_modulation signalscope_dsp signalscope_desktop_parameters signalscope_distribution signalscope_media_protocol signalscope_transport signalscope_dtmb_receiver)
  amc_check_module_links(signalscope-gui TRUE FALSE signalscope_core
                        signalscope_desktop_display signalscope_desktop_research signalscope_desktop_parameters signalscope_distribution signalscope_distribution_network)
endif()
endfunction()
# Some providers are assembled after this file is included. Check the final
# graph rather than silently omitting their targets during early configuration.
cmake_language(DEFER CALL amc_check_project_module_links)
